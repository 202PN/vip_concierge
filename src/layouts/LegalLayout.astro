---
/*
  Policy pages (privacy, terms): the sub-page opening, then the text on a
  white relief plate set to a reading measure.
*/
import BaseLayout from "./BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
}

const { title, description, heading, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageIntro title={heading} lede={`Last updated ${updated}.`} showActions={false} />

  <section class="legal-body field-paper">
    <div class="wrap">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-body {
    padding-block: var(--sect);
  }

  .prose {
    max-width: 68ch;
  }

  .prose :global(h2) {
    font-size: var(--text-h3);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul) {
    margin-bottom: 1rem;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.45rem;
  }

  .prose :global(strong) {
    font-weight: 500;
  }

  .prose :global(a) {
    color: var(--ox);
    font-weight: 500;
    text-underline-offset: 3px;
  }
</style>
