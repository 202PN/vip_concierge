---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import FleetCard from "../components/FleetCard.astro";
import CTABlock from "../components/CTABlock.astro";
import { byTier } from "../data/fleet";

const tiers = [
  {
    id: "armored",
    title: "Armored",
    note: "Level 6 ballistic protection, certified executive-security chauffeurs only.",
    vehicles: byTier("armored"),
  },
  {
    id: "executive",
    title: "Executive",
    note: "Executive sedans and SUVs for individuals and small teams.",
    vehicles: byTier("executive"),
  },
  {
    id: "group",
    title: "Group & Delegation",
    note: "Delegations, staff, and event groups on one vehicle and one schedule.",
    vehicles: byTier("group"),
  },
];
---

<BaseLayout
  title="Fleet — Armored, Executive & Group Vehicles | VIP Concierge"
  description="The VIP Concierge fleet by tier: Level 6 armored Escalade and Maybach, executive Mercedes S580 and Escalade, and group vehicles including Sprinter, Sienna, party bus, and coach bus."
>
  <PageIntro
    title="The Fleet"
    lede="Three tiers: armored, executive, and group. Every vehicle is late-model and professionally chauffeured. Select a vehicle to see photos and book."
    showActions={false}
  />

  <section class="tiers field-paper">
    <div class="wrap">
      {tiers.map((t) => (
        <div class="tier" id={t.id}>
          <div class="tier-head">
            <h2 class="h2">{t.title}</h2>
            <p class="on-paper-gray">{t.note}</p>
          </div>
          <div class="grid two">
            {t.vehicles.map((v) => (
              <FleetCard vehicle={v} showTier={false} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTABlock
    heading="Match a vehicle to the requirement."
    body="Tell us the passengers, luggage, and threat profile. We'll recommend the vehicle. Photos of group vehicles on request."
  />
</BaseLayout>

<style>
  .tiers {
    padding-block: var(--sect);
  }

  .tier {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .tier + .tier {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 3px solid var(--ink);
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .tier-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .tier-head p {
    font-size: var(--text-sm);
    max-width: 48ch;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
  }

  .grid.two {
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 720px) {
    .grid.two {
      grid-template-columns: 1fr;
    }
  }
</style>
