---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | VIP Concierge"
  description="The page you requested could not be found. VIP Concierge: first-class transportation and concierge services, Washington, DC and all 50 states, 24/7."
>
  <section class="nf">
    <div class="wrap">
      <h1>This route doesn't exist.</h1>
      <div class="foot">
        <p class="lede on-red-soft">
          We couldn't find that page. The operations desk, however, is very
          much reachable, 24 hours a day.
        </p>
        <div class="acts">
          <a class="btn btn-light" href="/" data-track="404-home">Return Home</a>
          <a class="btn btn-ghost" href="/contact" data-track="404-consult">Request a Consultation</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  h1 {
    font-size: clamp(2.5rem, 1.2rem + 5.2vw, 5rem);
    letter-spacing: -0.01em;
    max-width: 16ch;
  }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto;
    gap: 2.5rem;
    align-items: end;
    margin-top: clamp(1.75rem, 3.5vw, 3rem);
    border-top: 3px solid var(--ox-bright);
    padding-top: 1.75rem;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  @media (max-width: 900px) {
    .foot {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.5rem;
    }
  }
</style>
