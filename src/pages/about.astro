---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import CTABlock from "../components/CTABlock.astro";

const commitments = [
  {
    title: "Discretion",
    body: "Client identities, itineraries, and movements are never discussed, marketed, or disclosed.",
  },
  {
    title: "Capability",
    body: "Level 6 armored vehicles, certified executive-security chauffeurs, and an operations desk experienced in embassy, delegation, and government movements. [Credentials and licensing details: TBD]",
  },
  {
    title: "Reliability",
    body: "A live coordinator answers 24/7. Schedules are confirmed, vehicles arrive early, and changes are handled immediately.",
  },
];
---

<BaseLayout
  title="About — An Institutional Logistics & Security Partner | VIP Concierge"
  description="VIP Concierge is a McLean, Virginia transportation and concierge company serving government, corporate, and diplomatic clients with armored fleets, certified security chauffeurs, and 24/7 operations."
>
  <PageIntro
    title="An institutional partner"
    lede="We serve governments, corporations, and diplomatic missions in Washington and nationwide."
    showActions={false}
  />

  <section class="philosophy field-paper">
    <div class="wrap philosophy-grid">
      <div class="copy">
        <h2 class="h2">How we work</h2>
        <p class="lead-p">
          Every engagement is planned in advance: assessment, movement plan,
          vehicle. Schedules hold and itineraries stay confidential.
        </p>
        <p class="on-paper-gray">
          We operate from McLean, Virginia, minutes from Washington's
          institutions, handling armored and executive transportation,
          accommodation, travel, and document services.
        </p>
        <p class="tbd on-paper-gray">[Founding year and company history: TBD]</p>
      </div>
      <div class="emblem" aria-hidden="true">
        <img class="about-seal" src="/vip_red.png" alt="" width="200" height="200" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="commitments field-deep">
    <div class="wrap">
      <h2 class="h2">Our standards</h2>
      <dl class="commit-list">
        {commitments.map((c) => (
          <div class="commit-row">
            <dt>{c.title}</dt>
            <dd class="on-red-soft">{c.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CTABlock />
</BaseLayout>

<style>
  .philosophy {
    padding-block: var(--sect);
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: 3rem;
    align-items: center;
  }

  h2 {
    margin-bottom: 1.25rem;
  }

  .lead-p {
    font-size: var(--text-lg);
    font-weight: 450;
    max-width: 58ch;
    margin-bottom: 1rem;
  }

  .copy p {
    max-width: 60ch;
  }

  .tbd {
    font-size: var(--text-sm);
    margin-top: 1rem;
  }

  .emblem {
    display: grid;
    place-items: center;
  }

  .commitments {
    padding-block: var(--sect);
  }

  .commit-list {
    border-top: 3px solid var(--ox-bright);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .commit-row {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) 1fr;
    gap: 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line-onink);
  }

  .commit-row dt {
    font-size: var(--text-h3);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .commit-row dd {
    max-width: 62ch;
  }

  @media (max-width: 860px) {
    .philosophy-grid {
      grid-template-columns: 1fr;
    }

    .emblem {
      order: -1;
      justify-items: start;
    }

    .commit-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
