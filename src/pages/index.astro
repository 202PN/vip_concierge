---
import BaseLayout from "../layouts/BaseLayout.astro";
import GridGlobe from "../components/GridGlobe.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTABlock from "../components/CTABlock.astro";
import { serviceGroups } from "../data/services";
import { clients, type ClientLogo } from "../data/clients";
import MayoLogo from "../assets/clients/mayo.svg";
import HssLogo from "../assets/clients/hss.svg";
import BmcLogo from "../assets/clients/bmc.svg";
import ChildrensLogo from "../assets/clients/childrens.svg";
import HopkinsLogo from "../assets/clients/hopkins.svg";
import AfosiLogo from "../assets/clients/afosi.svg";
import UaeLogo from "../assets/clients/uae.svg";
import QatarEmbassyLogo from "../assets/clients/qatar-embassy.svg";
import QatarConsulateLogo from "../assets/clients/qatar-consulate.svg";
import SuitePlaceLogo from "../assets/clients/suiteplace.svg";
import AqraLogo from "../assets/clients/aqra.svg";
import SuiteSolutionsLogo from "../assets/clients/suitesolutions.svg";

const clientLogos: Record<ClientLogo, typeof MayoLogo> = {
  mayo: MayoLogo,
  hss: HssLogo,
  bmc: BmcLogo,
  childrens: ChildrensLogo,
  hopkins: HopkinsLogo,
  afosi: AfosiLogo,
  uae: UaeLogo,
  "qatar-embassy": QatarEmbassyLogo,
  "qatar-consulate": QatarConsulateLogo,
  suiteplace: SuitePlaceLogo,
  aqra: AqraLogo,
  suitesolutions: SuiteSolutionsLogo,
};
import { byTier, type Tier } from "../data/fleet";

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");

const fleetRows: { label: string; tier: Tier }[] = [
  { label: "Armored", tier: "armored" },
  { label: "Executive", tier: "executive" },
  { label: "Group", tier: "group" },
];

const cities = [
  "Washington DC",
  "Northern Virginia",
  "Baltimore",
  "New York",
  "Boston",
  "Miami",
  "Palm Beach",
  "Los Angeles",
  "Cleveland",
  "Cincinnati",
];
---

<BaseLayout
  title="VIP Concierge — First-class Transportation & Concierge | Washington, DC"
  description="Secure transportation and concierge services for government, corporate, and diplomatic clients: armored and executive fleets, furnished apartments, travel arrangement, and document authentication. Washington, DC and all 50 states, 24/7."
>
  <!-- Hero carousel -->
  <section class="hero" aria-roledescription="carousel" aria-label="VIP Concierge highlights">
    <article class="slide is-active" aria-roledescription="slide" aria-label="1 of 3">
      <video class="slide-video" src="/capital_traffic-1080.mp4" poster="/posters/capital_traffic-1080.jpg" autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
      <div class="slide-scrim" aria-hidden="true"></div>
      <div class="wrap slide-grid slide-grid-solo">
        <div class="slide-copy">
          <h1>First-class Transportation & Concierge</h1>
          <div class="hero-foot">
            <p class="lede on-red-soft">
              Secure transportation and concierge services for government,
              corporate, and diplomatic clients. Washington and all 50
              states, 24/7.
            </p>
            <div class="acts">
              <a class="btn btn-light" href="/contact" data-track="hero-consult">Request a Consultation</a>
              <a class="btn btn-ghost" href="/book" data-track="hero-book">Book Now</a>
            </div>
          </div>
        </div>
        <div class="slide-visual globe-visual" aria-hidden="true">
          <GridGlobe />
        </div>
      </div>
    </article>

    <article class="slide" aria-roledescription="slide" aria-label="2 of 3" aria-hidden="true">
      <video class="slide-video" src="/driving_int_bw.mp4" poster="/posters/driving_int_bw.jpg" muted loop playsinline preload="metadata" aria-hidden="true"></video>
      <div class="slide-scrim" aria-hidden="true"></div>
      <div class="wrap slide-grid slide-grid-solo">
        <div class="slide-copy">
          <h2 class="slide-title"><a class="title-link" href="/fleet">Armored, executive, and group vehicles.</a></h2>
          <div class="hero-foot">
            <p class="lede on-red-soft">
              Armored Escalades and Maybachs, executive sedans, and group
              vehicles up to full coach. Latest-model, chauffeured.
            </p>
            <div class="acts">
              <a class="btn btn-light" href="/fleet" data-track="hero-fleet">The Fleet</a>
              <a class="btn btn-ghost" href="/contact" data-track="hero-consult-2">Request a Consultation</a>
            </div>
          </div>
        </div>
      </div>
    </article>

    <article class="slide" aria-roledescription="slide" aria-label="3 of 3" aria-hidden="true">
      <video class="slide-video" src="/traffic_bw.mp4" poster="/posters/traffic_bw.jpg" muted loop playsinline preload="metadata" aria-hidden="true"></video>
      <div class="slide-scrim" aria-hidden="true"></div>
      <div class="wrap slide-grid">
        <div class="slide-copy">
          <h2 class="slide-title"><a class="title-link" href="/service-areas">The capital region and all fifty states.</a></h2>
          <div class="hero-foot">
            <p class="lede on-red-soft">
              Daily service in the capital region and major U.S. cities.
              Anywhere else in the 50 states, on request.
            </p>
            <div class="acts">
              <a class="btn btn-light" href="/service-areas" data-track="hero-areas">Service Areas</a>
              <a class="btn btn-ghost" href="/contact" data-track="hero-consult-3">Request a Consultation</a>
            </div>
          </div>
        </div>
        <div class="slide-visual map-visual" aria-hidden="true">
          <svg viewBox="0 0 440 348" fill="none">
            <!-- network map: DC hub, spokes to regularly served cities,
                 dashed routes trailing beyond the frame = anywhere on request.
                 When the slide arrives, the spokes plot outward from the hub
                 and each city lights as its route lands (--d staggers). -->
            <g class="map-routes" stroke="#a31515" stroke-width="1.8" opacity="0.85" fill="none">
              <path d="M320 168 Q 356 118 384 72" pathLength="1" style="--d: 150ms"></path>
              <path d="M320 168 Q 344 128 360 100" pathLength="1" style="--d: 230ms"></path>
              <path d="M320 168 Q 326 150 331 142" pathLength="1" style="--d: 310ms"></path>
              <path d="M320 168 Q 276 132 238 112" pathLength="1" style="--d: 390ms"></path>
              <path d="M320 168 Q 262 152 208 154" pathLength="1" style="--d: 470ms"></path>
              <path d="M320 168 Q 180 190 52 208" pathLength="1" style="--d: 550ms"></path>
              <path d="M320 168 Q 334 226 338 284" pathLength="1" style="--d: 630ms"></path>
              <path d="M320 168 Q 344 218 352 260" pathLength="1" style="--d: 710ms"></path>
            </g>
            <!-- routes that leave the map: coverage beyond the named cities -->
            <g class="map-far" stroke="#a31515" stroke-width="1.2" stroke-dasharray="2 5" opacity="0.5" fill="none">
              <path d="M320 168 Q 230 80 96 10"></path>
              <path d="M320 168 Q 220 250 60 322"></path>
              <path d="M320 168 Q 396 230 438 296"></path>
              <path d="M320 168 Q 180 160 4 140"></path>
            </g>
            <!-- unnamed destinations, reached on request -->
            <g class="map-far" fill="#ffffff" opacity="0.4">
              <circle cx="46" cy="58" r="2"></circle>
              <circle cx="140" cy="146" r="2"></circle>
              <circle cx="196" cy="238" r="2"></circle>
              <circle cx="282" cy="218" r="2"></circle>
              <circle cx="244" cy="86" r="2"></circle>
            </g>
            <g class="map-pts" font-family="Libre Franklin Variable, Arial, sans-serif" font-size="12" font-weight="500" letter-spacing="0.5">
              <circle cx="320" cy="168" r="7" stroke="#ffffff" stroke-width="2"></circle>
              <circle cx="320" cy="168" r="3" fill="#ffffff"></circle>
              <text x="304" y="194" fill="#ffffff" font-weight="600">Washington DC</text>
              <circle cx="384" cy="72" r="4" fill="#ffffff" style="--d: 500ms"></circle>
              <text x="360" y="58" fill="#b9b9c0" style="--d: 500ms">Boston</text>
              <circle cx="360" cy="100" r="4" fill="#ffffff" style="--d: 580ms"></circle>
              <text x="336" y="88" fill="#b9b9c0" style="--d: 580ms">New York</text>
              <circle cx="331" cy="142" r="4" fill="#ffffff" style="--d: 660ms"></circle>
              <text x="341" y="138" fill="#b9b9c0" style="--d: 660ms">Baltimore</text>
              <circle cx="238" cy="112" r="4" fill="#ffffff" style="--d: 740ms"></circle>
              <text x="206" y="98" fill="#b9b9c0" style="--d: 740ms">Cleveland</text>
              <circle cx="208" cy="154" r="4" fill="#ffffff" style="--d: 820ms"></circle>
              <text x="172" y="176" fill="#b9b9c0" style="--d: 820ms">Cincinnati</text>
              <circle cx="52" cy="208" r="4" fill="#ffffff" style="--d: 900ms"></circle>
              <text x="24" y="230" fill="#b9b9c0" style="--d: 900ms">Los Angeles</text>
              <circle cx="352" cy="260" r="4" fill="#ffffff" style="--d: 1060ms"></circle>
              <text x="362" y="258" fill="#b9b9c0" style="--d: 1060ms">Palm Beach</text>
              <circle cx="338" cy="284" r="4" fill="#ffffff" style="--d: 980ms"></circle>
              <text x="348" y="296" fill="#b9b9c0" style="--d: 980ms">Miami</text>
              <text x="14" y="342" fill="#b9b9c0" opacity="0.9" style="--d: 1200ms">+ anywhere in the 50 states, arranged on request</text>
            </g>
          </svg>
        </div>
      </div>
    </article>

    <button type="button" class="arrow arrow-prev" aria-label="Previous slide">
      <svg width="16" height="56" viewBox="0 0 16 56" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M15 1 L1 28 L15 55"></path>
      </svg>
    </button>
    <button type="button" class="arrow arrow-next" aria-label="Next slide">
      <svg width="16" height="56" viewBox="0 0 16 56" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M1 1 L15 28 L1 55"></path>
      </svg>
    </button>
    <div class="dots">
      <button type="button" class="dot" aria-label="Slide 1" aria-current="true"></button>
      <button type="button" class="dot" aria-label="Slide 2"></button>
      <button type="button" class="dot" aria-label="Slide 3"></button>
    </div>
  </section>

  <script>
    const hero = document.querySelector(".hero");
    const slides = [...(hero?.querySelectorAll(".slide") ?? [])];
    const dots = [...(hero?.querySelectorAll(".dot") ?? [])];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    // Phones in Low Power / Data Saver mode refuse autoplay: play() rejects
    // and the film sits on a still. Remember the refusal and retry on the
    // visitor's first touch, which counts as the gesture the browser wants.
    let autoplayBlocked = false;
    function playFilm(v: HTMLVideoElement) {
      v.play().catch(() => {
        autoplayBlocked = true;
      });
    }
    function retryFilm() {
      if (!autoplayBlocked) return;
      autoplayBlocked = false;
      const v = slides[index]?.querySelector("video");
      if (v && !reducedMotion) playFilm(v);
    }
    document.addEventListener("pointerdown", retryFilm, { passive: true });
    document.addEventListener("keydown", retryFilm);

    function go(i: number) {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.classList.toggle("is-active", n === index);
        s.setAttribute("aria-hidden", String(n !== index));
        const v = s.querySelector("video");
        if (v) {
          // The films are display:none under reduced motion — never play them.
          if (n === index && !reducedMotion) playFilm(v);
          else v.pause();
        }
      });
      dots.forEach((d, n) => {
        if (n === index) d.setAttribute("aria-current", "true");
        else d.removeAttribute("aria-current");
      });
    }

    // Manual choice ends auto-rotation.
    function stopAuto() {
      clearInterval(timer);
    }

    dots.forEach((d, n) =>
      d.addEventListener("click", () => {
        go(n);
        stopAuto();
      })
    );

    hero?.querySelector(".arrow-prev")?.addEventListener("click", () => {
      go(index - 1);
      stopAuto();
    });
    hero?.querySelector(".arrow-next")?.addEventListener("click", () => {
      go(index + 1);
      stopAuto();
    });

    // Touch: a horizontal swipe moves between slides (no buttons needed).
    let startX = 0;
    let startY = 0;
    let swiping = false;
    hero?.addEventListener(
      "pointerdown",
      (e) => {
        if (e.pointerType === "mouse") return;
        startX = e.clientX;
        startY = e.clientY;
        swiping = true;
      },
      { passive: true }
    );
    hero?.addEventListener("pointerup", (e) => {
      if (!swiping) return;
      swiping = false;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        go(dx < 0 ? index + 1 : index - 1);
        stopAuto();
      }
    });
    hero?.addEventListener("pointercancel", () => {
      swiping = false;
    });

    // The slides rotate for everyone. Under reduced motion the films are
    // hidden and the entrance animations are already flattened by the global
    // reduced-motion rule, so what remains is a plain crossfade of copy; the
    // dots and arrows still stop the rotation on demand.
    if (reducedMotion) slides.forEach((s) => s.querySelector("video")?.pause());
    timer = setInterval(() => go(index + 1), reducedMotion ? 9000 : 7000);
  </script>

  <!-- Chancery capability band -->
  <section class="band" aria-label="Capabilities">
    <ul>
      <li><a href="/fleet">Armored &amp; executive fleet</a></li>
      <li><a href="/armored-transportation">Certified security chauffeurs</a></li>
      <li><a href="/about">Embassy &amp; delegation experience</a></li>
      <li><a href="/service-areas">24/7, all 50 states</a></li>
    </ul>
  </section>

  <!-- Client register: who we serve, by sector -->
  <section class="clients field-ink" id="clients" aria-labelledby="clients-title">
    <div class="wrap">
      <h2 class="h2" id="clients-title">Clients</h2>
      <p class="dir-lede on-red-soft">
        Embassies, hospitals, and companies have trusted us with their
        people since 2014.
      </p>
    </div>
    <!-- Full-bleed strip: the register runs twice end to end so the loop is
         seamless; the second pass is decorative and hidden from assistive tech. -->
    <div class="marquee">
      <div class="marquee-track">
        {[false, true].map((copy) => (
          <ul class="wall" aria-hidden={copy ? "true" : undefined}>
            {clients.map((c) => {
              const Logo = c.logo && clientLogos[c.logo];
              return (
                <li class="wall-cell">
                  <div class="wall-mark">
                    {Logo ? (
                      <Logo class={`logo logo-${c.logo}`} role="img" aria-label={c.name} />
                    ) : (
                      <span class="wordmark">
                        <span class="wm-title">{c.mark?.title}</span>
                        {c.mark?.sub && <span class="wm-sub">{c.mark.sub}</span>}
                      </span>
                    )}
                  </div>
                  <span class="wall-place">
                    {c.note && <span class="wall-note">{c.note}</span>}
                    {c.place}
                  </span>
                </li>
              );
            })}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Client strip: drifts left on its own and can be dragged either way.
    // A release coasts on the throw's momentum, then eases back to the drift.
    // Under reduced motion none of this runs; the strip scrolls natively.
    const strip = document.querySelector<HTMLElement>(".marquee");
    const track = strip?.querySelector<HTMLElement>(".marquee-track");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (strip && track && !reduced) {
      const phone = window.matchMedia("(max-width: 720px)");
      const cells = track.querySelectorAll(".wall:first-child .wall-cell").length;
      let loop = 0; // width of one pass; the second pass makes the wrap seamless
      let offset = 0;
      let throwV = 0; // px/s left over from a release
      let dragging = false;
      let hovering = false;
      let visible = true;
      let lastX = 0;
      let lastT = 0;
      let prev = 0;

      const measure = () => {
        loop = track.querySelector<HTMLElement>(".wall")?.offsetWidth ?? 0;
      };
      // Same pace per client as the old CSS loop: 2.9s each, 2.15s on phones.
      const drift = () => (loop ? loop / (cells * (phone.matches ? 2.15 : 2.9)) : 0);

      function frame(now: number) {
        const dt = Math.min((now - prev) / 1000, 0.05);
        prev = now;
        if (!dragging) {
          offset += ((hovering ? 0 : drift()) + throwV) * dt;
          throwV *= Math.exp(-dt * 3.5);
        }
        if (loop) offset = ((offset % loop) + loop) % loop;
        track!.style.translate = `${-offset}px 0`;
        if (visible) requestAnimationFrame(frame);
      }

      function start() {
        prev = performance.now();
        requestAnimationFrame(frame);
      }

      strip.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") hovering = true;
      });
      strip.addEventListener("pointerleave", (e) => {
        if (e.pointerType === "mouse") hovering = false;
      });

      strip.addEventListener("pointerdown", (e) => {
        dragging = true;
        throwV = 0;
        lastX = e.clientX;
        lastT = e.timeStamp;
        strip.setPointerCapture(e.pointerId);
        strip.classList.add("is-dragging");
      });
      strip.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dx = e.clientX - lastX;
        const dt = Math.max((e.timeStamp - lastT) / 1000, 0.001);
        offset -= dx;
        // Smoothed so one jittery sample can't fling the strip
        throwV = 0.7 * (-dx / dt) + 0.3 * throwV;
        lastX = e.clientX;
        lastT = e.timeStamp;
      });
      const release = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        strip.classList.remove("is-dragging");
        // A pause before letting go means a placement, not a throw.
        if (e.timeStamp - lastT > 80) throwV = 0;
        throwV = Math.max(-2500, Math.min(2500, throwV));
      };
      strip.addEventListener("pointerup", release);
      strip.addEventListener("pointercancel", release);

      // Only animate while the strip is on screen.
      new IntersectionObserver(([entry]) => {
        const was = visible;
        visible = entry.isIntersecting;
        if (visible && !was) start();
      }).observe(strip);

      new ResizeObserver(measure).observe(track);
      measure();
      start();
    }
  </script>

  <!-- Services directory: Transportation + Concierge -->
  <section class="directory field-deep" id="services">
    <div class="wrap">
      <h2 class="h2"><a class="h-link" href="/services">Services</a></h2>
      <p class="dir-lede on-red-soft">
        Transportation, accommodation, travel, and document services under
        one team.
      </p>
      {serviceGroups.map((g) => (
        <div class="dir-group">
          <div class="group-head">
            <h3><a class="h-link" href={`/services#${slug(g.title)}`}>{g.title}</a></h3>
          </div>
          <ul class="dir-list">
            {g.items.map((s) => (
              <ServiceCard title={s.name} href={s.href} summary={s.note} />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- White relief: fleet + coverage -->
  <section class="duo field-paper">
    <div class="cell" id="fleet">
      <h2 class="h2"><a class="h-link" href="/fleet">Fleet</a></h2>
      <dl>
        {fleetRows.map((r) => (
          <div>
            <dt>{r.label}</dt>
            <dd>
              {byTier(r.tier).map((v, i) => (
                <>
                  {i > 0 && " · "}
                  <a href={`/fleet#${v.id}`}>{v.name}</a>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
      <p class="tbd on-paper-gray">Group vehicle photos available on request.</p>
    </div>
    <div class="cell" id="service-areas">
      <h2 class="h2"><a class="h-link" href="/service-areas">Service areas</a></h2>
      <p class="cities">{cities.join(" · ")} · <a href="/contact">+ any city on request</a></p>
    </div>
  </section>

  <CTABlock />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Full-viewport cinematic carousel; runs up under the transparent header
       and rests each slide's copy low, in the Mercedes manner. Slides stack
       in one grid cell so the tallest slide sets the hero's height. */
    margin-top: calc(-1 * var(--header-h));
    display: grid;
    touch-action: pan-y;
  }

  .slide {
    grid-area: 1 / 1;
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: calc(var(--header-h) + 2rem) clamp(4.5rem, 10vh, 7rem);
    opacity: 0;
    visibility: hidden;
    transition: opacity 700ms ease, visibility 700ms;
    pointer-events: none;
  }

  .slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Orchestrated entrance: the copy rises as the slide arrives,
     and the active film breathes with a slow cinematic drift. */
  .slide .slide-copy {
    opacity: 0;
    translate: 0 28px;
    transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1),
      translate 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .slide.is-active .slide-copy {
    opacity: 1;
    translate: 0 0;
    transition-delay: 150ms;
  }

  .slide.is-active .slide-video {
    animation: film-drift 9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes film-drift {
    from {
      scale: 1;
    }
    to {
      scale: 1.05;
    }
  }

  .slide-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .slide-grid-solo {
    grid-template-columns: 1fr;
  }

  .slide-visual {
    align-self: center;
    justify-self: end;
    width: min(34vw, 26rem);
    opacity: 0.95;
  }

  /* Slide 1's globe at monumental scale, raised, bleeding off the right edge;
     it sits behind the headline, never over it. */
  .globe-visual {
    position: absolute;
    top: 30%;
    right: clamp(-16rem, -12vw, -7rem);
    translate: 0 -50%;
    width: min(56vw, 50rem);
    opacity: 0.9;
    pointer-events: none;
    z-index: 0;
  }

  .slide-copy {
    position: relative;
    z-index: 1;
  }

  .map-visual {
    width: min(48vw, 38rem);
    translate: 0 -2.5rem;
  }

  /* Coverage plots itself each time the slide arrives: the hub holds,
     spokes draw outward (pathLength-normalized), each city lights as its
     route lands, and the dashed beyond-the-map routes surface last. */
  .slide.is-active .map-visual :global(.map-routes path) {
    stroke-dasharray: 1;
    animation: route-draw 600ms cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms) backwards;
  }

  .slide.is-active .map-visual :global(.map-pts > *) {
    animation: map-fade 450ms ease-out var(--d, 0ms) backwards;
  }

  .slide.is-active .map-visual :global(.map-far) {
    animation: map-fade 600ms ease-out 1000ms backwards;
  }

  @keyframes route-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes map-fade {
    from {
      opacity: 0;
