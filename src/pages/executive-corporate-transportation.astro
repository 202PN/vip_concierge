---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import FleetCard from "../components/FleetCard.astro";
import CTABlock from "../components/CTABlock.astro";
import { byTier } from "../data/fleet";

const fleet = [...byTier("executive"), ...byTier("group")];

const programs = [
  {
    title: "Airport transfers",
    body: "We track your flight and position the chauffeur before the doors open, with a gate or curb meet at DCA, IAD, BWI, and private terminals.",
  },
  {
    title: "Roadshows & multi-stop days",
    body: "One vehicle, one chauffeur, and a coordinator re-sequencing stops as the day changes.",
  },
  {
    title: "Group & event transportation",
    body: "Move the whole party together in a Sprinter, Sienna, party bus, or coach. One manifest, one schedule, professional chauffeurs throughout.",
  },
  {
    title: "As-directed service",
    body: "A vehicle and chauffeur at your disposal all day, for schedules that keep changing.",
  },
  {
    title: "Corporate accounts",
    body: "Standing arrangements for recurring needs: consistent chauffeurs, direct booking, consolidated billing. Account terms available on request.",
  },
];
---

<BaseLayout
  title="Executive & Group Transportation | VIP Concierge"
  description="Chauffeured transportation in Washington, DC and nationwide: Mercedes S580, Escalade, Mercedes Sprinter, Toyota Sienna, party bus, and coach bus. Airport transfers, roadshows, group and event movements, 24/7."
>
  <PageIntro
    service={"Executive & Group Transportation"}
    title="Executive & Group Transportation"
    lede="Chauffeured transportation from a single executive sedan to a full coach. Latest-model vehicles, professional chauffeurs, 24/7."
  />

  <section class="programs field-paper">
    <div class="wrap">
      <h2 class="h2">Programs</h2>
      <dl class="list">
        {programs.map((p) => (
          <div class="row">
            <dt>{p.title}</dt>
            <dd class="on-paper-gray">{p.body}</dd>
          </div>
        ))}
      </dl>

      <hr class="rule-heavy spacer" aria-hidden="true" />
      <h2 class="h2">The vehicles</h2>
      <p class="sec-lede on-paper-gray">
        Latest-model vehicles, matched to party size and luggage.
      </p>
      <div class="vehicle-grid">
        {fleet.map((v) => (
          <FleetCard vehicle={v} />
        ))}
      </div>
    </div>
  </section>

  <CTABlock variant="book" heading="Reservations." service={"Executive & Group Transportation"} />
</BaseLayout>

<style>
  .programs {
    padding-block: var(--sect);
  }

  h2 {
    margin-bottom: 1.25rem;
  }

  .list {
    border-top: 3px solid var(--ink);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) 1fr;
    gap: 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--ink);
  }

  .row dt {
    font-size: var(--text-h3);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .row dd {
    max-width: 62ch;
  }

  .spacer {
    margin-block: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .sec-lede {
    max-width: 56ch;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .vehicle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 960px) {
    .vehicle-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
