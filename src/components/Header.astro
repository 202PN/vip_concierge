---
import { serviceGroups } from "../data/services";

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="notice" role="note" aria-label="Availability">
    <div class="wrap notice-inner">
      <p class="notice-text">
        <span class="notice-dot" aria-hidden="true"></span>
        <span class="notice-label notice-long">At your service 24 hours a day, 7 days a week</span>
        <span class="notice-label notice-short">Available 24/7</span>
      </p>
      <div class="notice-contact">
        <a class="notice-phone" href="tel:+17032874227" aria-label="Call +1 703-287-4227">+1 703-287-4227</a>
        <a class="notice-wa" href="https://wa.me/17032874227" rel="noopener" target="_blank" aria-label="Message us on WhatsApp" title="WhatsApp">
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.2-.6-.3zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8zm0-21.6C5.6.2.4 5.4.4 11.8c0 2 .5 4 1.5 5.8L.3 23.7l6.2-1.6c1.7.9 3.6 1.4 5.5 1.4 6.4 0 11.6-5.2 11.6-11.6S18.4.2 12 .2z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="wrap bar">
    <a class="brand" href="/" aria-label="VIP Concierge — home">
      <img
        class="brand-logo"
        src="/vip_red2_sm.png"
        alt=""
        width="46"
        height="46"
      />
      <span class="brand-name">VIP&nbsp;Concierge</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav-list">
        <li class="has-menu">
          <a class="menu-trigger" href="/services" aria-current={current === "/services" ? "page" : undefined}>
            Services
            <svg width="10" height="7" viewBox="0 0 10 7" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 1.5 5 5.5 9 1.5"></path>
            </svg>
          </a>
          <div class="menu" id="services-menu">
            {serviceGroups.map((g) => (
              <div class="menu-group">
                <p class="menu-title">{g.title}</p>
                <ul>
                  {g.items.map((s) => (
                    <li><a href={s.href} aria-current={current === s.href ? "page" : undefined}>{s.name}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <a class="menu-all" href="/services">All services →</a>
          </div>
        </li>
        <li><a href="/fleet" aria-current={current === "/fleet" ? "page" : undefined}>Fleet</a></li>
        <li><a href="/service-areas" aria-current={current === "/service-areas" ? "page" : undefined}>Service Areas</a></li>
        <li><a href="/about" aria-current={current === "/about" ? "page" : undefined}>About</a></li>
        <li><a href="/contact" aria-current={current === "/contact" ? "page" : undefined}>Contact</a></li>
      </ul>
    </nav>

    <div class="actions">
      <a class="btn btn-ghost btn-compact" href="/contact" data-track="header-consult">Request a Consultation</a>
      <a class="btn btn-light btn-compact" href="/book" data-track="header-book">Book Now</a>
    </div>

    <button type="button" class="hamburger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Primary mobile" hidden>
    {serviceGroups.map((g) => (
      <div class="mobile-group">
        <p class="mobile-group-label">{g.title}</p>
        <ul>
          {g.items.map((s) => (
            <li><a href={s.href} aria-current={current === s.href ? "page" : undefined}>{s.name}</a></li>
          ))}
        </ul>
      </div>
    ))}
    <ul class="mobile-top">
      <li><a href="/services" aria-current={current === "/services" ? "page" : undefined}>All Services</a></li>
      <li><a href="/fleet" aria-current={current === "/fleet" ? "page" : undefined}>Fleet</a></li>
      <li><a href="/service-areas" aria-current={current === "/service-areas" ? "page" : undefined}>Service Areas</a></li>
      <li><a href="/about" aria-current={current === "/about" ? "page" : undefined}>About</a></li>
      <li><a href="/contact" aria-current={current === "/contact" ? "page" : undefined}>Contact</a></li>
    </ul>
    <div class="mobile-actions">
      <a class="btn btn-ghost" href="/contact" data-track="header-consult">Request a Consultation</a>
      <a class="btn btn-light" href="/book" data-track="header-book">Book Now</a>
    </div>
    <p class="mobile-phone">
      Answered 24/7: <a href="tel:+17032874227">+1 703-287-4227</a>
    </p>
  </nav>
</header>

<script>
  const header = document.querySelector(".site-header");
  const hamburger = header?.querySelector(".hamburger");
  const mobileNav = header?.querySelector<HTMLElement>(".mobile-nav");
  const menuItem = header?.querySelector<HTMLElement>(".has-menu");

  hamburger?.addEventListener("click", () => {
    const open = hamburger.getAttribute("aria-expanded") === "true";
    hamburger.setAttribute("aria-expanded", String(!open));
    if (mobileNav) mobileNav.hidden = open;
    header?.classList.toggle("menu-open", !open);
  });

  // Transparent at rest; slightly-white surface once the page moves.
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header?.classList.toggle("scrolled", window.scrollY > 8);
      ticking = false;
    });
  }
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // "Services" is a real link to /services; the dropdown opens on hover and
  // on keyboard focus (CSS). Escape drops focus so the menu closes.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuItem?.contains(document.activeElement)) {
      (document.activeElement as HTMLElement | null)?.blur();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 250ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 250ms cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Moved: a transparent gray, softly blurred surface. Text stays white. */
  .site-header.scrolled:not(.menu-open) {
    background: rgba(28, 28, 32, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line-onink);
  }

  /* Open mobile menu always sits on a solid ink bar, whatever the scroll. */
  .site-header.menu-open {
    background: var(--ink);
    border-bottom-color: var(--line-onink);
  }

  .brand-name,
  .nav-list a,
  .menu-trigger,
  .hamburger {
    transition: color 200ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 200ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 24/7 notice: a quiet, solid strip that rides above the transparent bar. */
  .notice {
    background: var(--ink);
    border-bottom: 1px solid var(--line-onink);
  }

  .notice-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--notice-h);
  }

  .notice-text {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft-ink);
    white-space: nowrap;
    min-width: 0;
  }

  .notice-label {
    color: var(--paper);
    font-weight: 500;
  }

  .notice-short {
    display: none;
  }

  .notice-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2fbf71;
    box-shadow: 0 0 0 0 rgba(47, 191, 113, 0.55);
    animation: notice-pulse 2.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes notice-pulse {
    0% { box-shadow: 0 0 0 0 rgba(47, 191, 113, 0.55); }
    70%, 100% { box-shadow: 0 0 0 7px rgba(47, 191, 113, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice-dot {
      animation: none;
    }
  }

  .notice-contact {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .notice-wa {
    display: inline-flex;
    align-items: center;
    color: var(--soft-ink);
    transition: color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .notice-wa:hover {
    color: var(--paper);
  }

  .notice-phone {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--paper);
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    transition: color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .notice-phone:hover {
    color: var(--ox-bright);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: var(--bar-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-right: auto;
  }

  .brand-logo {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
  }

  .brand-name {
    font-weight: 400;
    font-size: 1.1875rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
  }

  .nav-list a,
  .menu-trigger {
    font-size: var(--text-sm);
    font-weight: 450;
    color: var(--paper);
    text-decoration: none;
    padding-block: 0.4rem;
  }

  .nav-list a:hover,
  .menu-trigger:hover {
    color: var(--ox-bright);
  }

  .nav-list a[aria-current="page"] {
    box-shadow: 0 2px 0 0 var(--paper);
  }

  .menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .has-menu {
    position: relative;
  }

  .menu {
    position: absolute;
    top: calc(100% + 1rem);
    left: -1.5rem;
    min-width: 21rem;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    padding: 1.25rem 1.5rem 1rem;
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    transition: opacity 150ms ease-out, translate 150ms ease-out, visibility 150ms;
  }

  .has-menu:hover .menu,
  .has-menu:focus-within .menu {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }

  .menu-group + .menu-group {
    margin-top: 1.1rem;
  }

  .menu-title {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ox);
    border-bottom: 1px solid var(--line-paper);
    padding-bottom: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .menu ul {
    list-style: none;
    padding: 0;
  }

  .menu ul a {
    display: block;
    padding: 0.4rem 0;
    color: var(--ink);
    font-weight: 500;
  }

  .menu ul a:hover {
    color: var(--ox);
  }

  .menu-all {
    display: block;
    margin-top: 1.1rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink);
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--ox) !important;
    text-decoration: none;
  }

  .menu-all:hover {
    color: var(--ink) !important;
  }

  .actions {
    display: flex;
    gap: 0.6rem;
  }

  .btn-compact {
    padding: 0.55rem 1.05rem;
    font-size: 0.8125rem;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 2px solid var(--line-onink);
    cursor: pointer;
    padding: 0 0.55rem;
  }

  .hamburger:hover {
    border-color: var(--paper);
  }

  .hamburger span {
    display: block;
    height: 2px;
    background: var(--paper);
    transition: rotate 200ms ease-out, opacity 150ms, translate 200ms ease-out,
      background-color 200ms ease-out;
  }

  .hamburger[aria-expanded="true"] span:nth-child(1) {
    rotate: 45deg;
    translate: 0 7px;
  }

  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .hamburger[aria-expanded="true"] span:nth-child(3) {
    rotate: -45deg;
    translate: 0 -7px;
  }

  .mobile-nav {
    border-top: 1px solid var(--line-onink);
    background: var(--ink);
    padding: 1.5rem var(--gutter) 2rem;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }

  .mobile-nav ul {
    list-style: none;
    padding: 0;
  }

  .mobile-group-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ox-bright);
    border-bottom: 1px solid var(--line-onink);
    padding-bottom: 0.4rem;
    margin-bottom: 0.3rem;
  }

  .mobile-group + .mobile-group {
    margin-top: 1.25rem;
  }

  .mobile-group a {
    display: block;
    font-weight: 400;
    font-size: 1.125rem;
    text-decoration: none;
    padding-block: 0.45rem;
  }

  .mobile-top {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line-onink);
    padding-top: 0.75rem !important;
  }

  .mobile-top a {
    display: block;
    font-weight: 450;
    font-size: 1rem;
    text-decoration: none;
    padding-block: 0.45rem;
  }

  .mobile-actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .mobile-phone {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: var(--soft-ink);
  }

  .mobile-phone a {
    color: var(--paper);
    font-weight: 500;
    text-decoration: none;
  }

  /* The bar gives ground progressively so the full nav survives down to
     phone width: first the consultation button goes (Contact stays in the
     nav), then spacing tightens, then the wordmark yields to the seal.
     Only phones get the hamburger. */
  @media (max-width: 1150px) {
    .actions .btn-ghost {
      display: none;
    }
  }

  @media (max-width: 1000px) {
    .bar {
      gap: 1.25rem;
    }

    .nav-list {
      gap: 1rem;
    }

    .brand-name {
      font-size: 1.0625rem;
    }
  }

  @media (max-width: 880px) {
    .brand-name {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .nav {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    /* Book Now stays beside the hamburger at every width. */
    .bar {
      gap: 0.85rem;
    }

    .notice-long {
      display: none;
    }

    .notice-short {
      display: inline;
    }
  }

  /* The phone number is a one-tap call: it stays; the label shrinks first. */
  @media (max-width: 480px) {
    .notice-text {
      font-size: 0.625rem;
      gap: 0.5rem;
    }
  }

  @media (max-width: 360px) {
    .notice-label {
      display: none;
    }
  }

  @media (min-width: 721px) {
    .mobile-nav {
      display: none;
    }
  }
</style>
