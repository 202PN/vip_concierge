---
import { serviceGroups } from "../data/services";
const year = new Date().getFullYear();
---

<footer class="site-footer field-ink">
  <div class="wrap">
    <hr class="rule-heavy" aria-hidden="true" />
    <div class="cols">
      <div class="col-brand">
        <img class="footer-seal" src="/vip_red_sm.png" alt="" width="64" height="64" loading="lazy" />
        <p class="brand-line">VIP Concierge</p>
        <p class="on-ink-soft">
          First-class transportation and concierge services for government,
          corporate, and delegation clients. Washington, DC and all 50
          states, 24/7.
        </p>
      </div>

      {serviceGroups.map((g) => (
        <nav class="col" aria-label={`Footer — ${g.title}`}>
          <h2>{g.title}</h2>
          <ul>
            {g.items.map((s) => (
              <li><a href={s.href}>{s.name}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="col">
        <h2>Contact</h2>
        <address>
          <p>8200 Greensboro Dr., Suite 900<br />McLean, VA 22102</p>
          <p>
            <a href="tel:+17032874227">+1 703-287-4227</a><br />
            <a href="https://wa.me/17032874227" rel="noopener">Message us on WhatsApp</a><br />
            <a href="mailto:info@dcvipconcierge.com">info@dcvipconcierge.com</a>
          </p>
        </address>
        <ul class="quick">
          <li><a href="/services">All Services</a></li>
          <li><a href="/fleet">Fleet</a></li>
          <li><a href="/service-areas">Service Areas</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/book">Book Now</a></li>
        </ul>
      </div>
    </div>

    <div class="legal">
      <p>© {year} VIP Concierge. All rights reserved.</p>
      <ul class="policies">
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Use</a></li>
      </ul>
      <ul class="social">
        <li>
          <a href="https://facebook.com/DCVIPCONCIERGE" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>
            Facebook
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/company/vip-concierge-llc/" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a href="https://twitter.com/DCVIPconcierge" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" /></svg>
            X&nbsp;(Twitter)
          </a>
        </li>
      </ul>
      <p class="on-ink-soft">Available 24 hours a day, 7 days a week.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--sect) 2.5rem;
    background: #101013;
  }

  .rule-heavy {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .cols {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
  }

  .footer-seal {
    display: block;
    margin-bottom: 1rem;
  }

  .brand-line {
    font-weight: 400;
    font-size: var(--text-lg);
    margin-bottom: 0.6rem;
  }

  .col-brand p {
    max-width: 34ch;
    font-size: var(--text-sm);
  }

  .col h2 {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft-ink);
    margin-bottom: 1rem;
  }

  .col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .col a {
    color: var(--paper);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 450;
  }

  .col a:hover {
    color: var(--ox-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  address {
    font-style: normal;
    font-size: var(--text-sm);
    display: grid;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  address a {
    color: var(--paper);
    font-weight: 450;
    text-decoration: none;
  }

  address a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .quick {
    display: flex !important;
    flex-wrap: wrap;
    gap: 0.4rem 1rem !important;
  }

  .legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line-onink);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    font-size: var(--text-xs);
  }

  .social,
  .policies {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .social a,
  .policies a {
    color: var(--paper);
    font-weight: 500;
    text-decoration: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .social svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: currentColor;
    flex: none;
  }

  .social a:hover,
  .policies a:hover {
    color: var(--ox-bright);
  }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
