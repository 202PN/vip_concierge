---
/*
  Vehicle plate — Chancery grammar for white relief sections:
  2px ink border, photo frame, tier mark, inquire action.
  Vehicles without a public photograph (armored, buses) show
  "Photos available on request" in the frame instead.
*/
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  tier: string;
  capacity?: string;
  description: string;
  image?: ImageMetadata;
  /* Hide the tier mark when the card sits under a tier heading (e.g. /fleet). */
  showTier?: boolean;
}

const { name, tier, capacity = "[TBD]", description, image, showTier = true } = Astro.props;
---

<article class="fleet-card">
  {
    image ? (
      <div class="photo">
        <Image
          src={image}
          alt={name}
          widths={[480, 760, 1140]}
          sizes="(max-width: 720px) 92vw, 570px"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="photo-tbd" role="img" aria-label={`${name}, photos available on request`}>
        Photos available on request
      </div>
    )
  }
  <div class="spec">
    {showTier && <p class="tier">{tier}</p>}
    <h3>{name}</h3>
    <p class="cap"><span>Passengers</span> {capacity}</p>
    <p class="desc">{description}</p>
    <a class="inquire" href="/contact" data-track={`fleet-inquire-${name.toLowerCase().replace(/\s+/g, "-")}`}>
      Inquire about this vehicle →
    </a>
  </div>
</article>

<style>
  .fleet-card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .photo-tbd {
    aspect-ratio: 16 / 10;
    min-height: 0;
    border: 0;
    border-bottom: 2px solid var(--ink);
  }

  .photo {
    aspect-ratio: 16 / 10;
    border-bottom: 2px solid var(--ink);
    background: var(--paper-dim);
    padding: 0.5rem;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .spec {
    padding: 1.4rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .tier {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ox);
  }

  h3 {
    font-size: var(--text-h3);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .cap {
    font-size: var(--text-sm);
    font-weight: 500;
    border-block: 1px solid var(--line-paper);
    padding-block: 0.5rem;
    margin-block: 0.3rem;
  }

  .cap span {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray);
    margin-right: 0.5rem;
  }

  .desc {
    font-size: var(--text-sm);
    color: var(--gray);
    flex: 1;
  }

  .inquire {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--ox);
    text-decoration: none;
  }

  .inquire:hover {
    color: var(--ink);
  }
</style>
