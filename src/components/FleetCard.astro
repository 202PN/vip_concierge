---
/*
  Vehicle plate — Chancery grammar for white relief sections:
  2px ink border, photo frame, tier mark, inquire action.

  The whole card opens a viewer (native <dialog>) holding every photo of the
  vehicle in a swipeable, arrow-keyed strip, the specification, and the two
  actions: Book Now and "Inquire about this vehicle" (which lands on the
  contact form with the service pill and vehicle already selected).
  Vehicles without a public photograph (armored Escalade, buses) show
  "Photos available on request" in the frame instead.
*/
import { Image } from "astro:assets";
import { inquireHref, type Vehicle } from "../data/fleet";

interface Props {
  vehicle: Vehicle;
  /* Hide the tier mark when the card sits under a tier heading (e.g. /fleet). */
  showTier?: boolean;
}

const { vehicle, showTier = true } = Astro.props;
const { id, name, tierLabel, capacity, description, images, coverFit = "contain" } = vehicle;
const cover = images[0];
const count = images.length;
const armored = vehicle.tier === "armored";
const inquire = inquireHref(vehicle);
const viewerId = `viewer-${id}`;
---

<article class="fleet-card" id={id} data-vehicle={name}>
  <button
    type="button"
    class="card-open"
    aria-haspopup="dialog"
    aria-controls={viewerId}
    aria-label={`View ${name}${count ? `, ${count} photo${count === 1 ? "" : "s"}` : ""}`}
  >
    {
      cover ? (
        <span class:list={["photo", { "photo-cover": coverFit === "cover" }]}>
          <Image
            src={cover}
            alt={name}
            widths={[480, 760, 1140]}
            sizes="(max-width: 720px) 92vw, 570px"
            loading="lazy"
          />
          {count > 1 && <span class="count" aria-hidden="true">{count} photos</span>}
        </span>
      ) : (
        <span class="photo-tbd" role="img" aria-label={`${name}, photos available on request`}>
          Photos available on request
        </span>
      )
    }
  </button>

  <div class="spec">
    {showTier && <p class="tier">{tierLabel}</p>}
    <h3>{name}</h3>
    <p class="cap"><span>Passengers</span> {capacity}</p>
    <p class="desc">{description}</p>
    <div class="row">
      <span class="view" aria-hidden="true">View vehicle →</span>
      <a class="inquire" href={inquire} data-track={`fleet-inquire-${id}`}>
        Inquire about this vehicle →
      </a>
    </div>
  </div>

  <dialog class="viewer" id={viewerId} aria-labelledby={`${viewerId}-title`}>
    <div class="frame">
      <button type="button" class="close" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 2l12 12M14 2L2 14"></path>
        </svg>
      </button>

      <div class="gallery" data-count={count}>
        <div class="track" tabindex="0" aria-label={`${name} photos`} aria-roledescription="carousel">
          {
            count ? (
              images.map((img, i) => (
                <figure class="shot" aria-label={`Photo ${i + 1} of ${count}`}>
                  <Image
                    src={img}
                    alt={`${name}, photo ${i + 1} of ${count}`}
                    widths={[640, 1024, 1600]}
                    sizes="(max-width: 900px) 100vw, 56rem"
                    loading="lazy"
                  />
                </figure>
              ))
            ) : (
              <div class="shot photo-tbd" role="img" aria-label={`${name}, photos available on request`}>
                Photos available on request
              </div>
            )
          }
        </div>
        {
          count > 1 && (
            <>
              <button type="button" class="step prev" aria-label="Previous photo">
                <svg width="10" height="18" viewBox="0 0 10 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M9 1 1 9l8 8"></path>
                </svg>
              </button>
              <button type="button" class="step next" aria-label="Next photo">
                <svg width="10" height="18" viewBox="0 0 10 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M1 1l8 8-8 8"></path>
                </svg>
              </button>
              <p class="counter" aria-live="polite"><span class="cur">1</span> / {count}</p>
            </>
          )
        }
      </div>

      <div class="detail">
        <p class="tier">{tierLabel}</p>
        <h2 id={`${viewerId}-title`}>{name}</h2>
        <p class="cap"><span>Passengers</span> {capacity}</p>
        <p class="desc">{description}</p>
        {
          armored && (
            <p class="note on-paper-gray">
              Armored movements are planned with a senior coordinator rather than booked online.
            </p>
          )
        }
        <div class="acts">
          {
            armored ? (
              <>
                <a class="btn btn-red" href={inquire} data-track={`fleet-inquire-${id}`}>Inquire About This Vehicle</a>
                <a class="btn btn-outline" href="tel:+17032874227" data-track={`fleet-call-${id}`}>Call +1 703-287-4227</a>
              </>
            ) : (
              <>
                <a class="btn btn-red" href="/book" data-track={`fleet-book-${id}`}>Book Now</a>
                <a class="btn btn-outline" href={inquire} data-track={`fleet-inquire-${id}`}>Inquire About This Vehicle</a>
              </>
            )
          }
        </div>
        <p class="phone on-paper-gray">
          Inquiries: <a href="tel:+17032874227">+1 703-287-4227</a> ·
          <a href="https://wa.me/17032874227" rel="noopener">WhatsApp</a> · answered 24/7
        </p>
      </div>
    </div>
  </dialog>
</article>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".fleet-card");

  cards.forEach((card) => {
    const dialog = card.querySelector<HTMLDialogElement>("dialog.viewer");
    const opener = card.querySelector<HTMLButtonElement>(".card-open");
    if (!dialog || !opener) return;

    const track = dialog.querySelector<HTMLElement>(".track");
    const prev = dialog.querySelector<HTMLButtonElement>(".prev");
    const next = dialog.querySelector<HTMLButtonElement>(".next");
    const cur = dialog.querySelector<HTMLElement>(".cur");
    const shots = track?.querySelectorAll(".shot").length ?? 0;

    function index() {
      if (!track) return 0;
      return Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
    }

    function sync() {
      const i = index();
      if (cur) cur.textContent = String(i + 1);
      if (prev) prev.disabled = i <= 0;
      if (next) next.disabled = i >= shots - 1;
    }

    function step(dir: 1 | -1) {
      if (!track) return;
      const target = Math.min(Math.max(index() + dir, 0), shots - 1);
      track.scrollTo({ left: target * track.clientWidth, behavior: "smooth" });
    }

    function open() {
      if (dialog!.open) return;
      dialog!.showModal();
      track?.scrollTo({ left: 0 });
      sync();
      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({ event: "fleet_view", vehicle: card.dataset.vehicle });
    }

    opener.addEventListener("click", open);
    dialog.querySelector(".close")?.addEventListener("click", () => dialog.close());
    // Click on the backdrop (outside the frame) closes.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => opener.focus({ preventScroll: true }));

    prev?.addEventListener("click", () => step(-1));
    next?.addEventListener("click", () => step(1));

    let ticking = false;
    track?.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          sync();
          ticking = false;
        });
      },
      { passive: true }
    );

    dialog.addEventListener("keydown", (e) => {
      if (shots < 2) return;
      if (e.key === "ArrowRight") {
        e.preventDefault();
        step(1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        step(-1);
      }
    });

    // Deep link: /fleet#<vehicle-id> (used by the home page) opens the viewer.
    function openIfTargeted() {
      if (location.hash.slice(1) === card.id) open();
    }
    openIfTargeted();
    window.addEventListener("hashchange", openIfTargeted);
  });
</script>

<style>
  .fleet-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    scroll-margin-top: calc(var(--header-h) + 1rem);
    transition: border-color 160ms ease-out, box-shadow 160ms ease-out;
  }

  /* The whole plate is the trigger: the button's pseudo-element spreads
     over the card; the inquire link rides above it. */
  .card-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .card-open::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-open:focus-visible {
    outline: 0;
  }

  .fleet-card:has(.card-open:focus-visible) {
    outline: 3px solid var(--ox);
    outline-offset: 3px;
  }

  .fleet-card:has(.card-open:hover) {
    border-color: var(--ox);
  }

  .photo-tbd {
    display: grid;
    aspect-ratio: 16 / 10;
    min-height: 0;
    border: 0;
    border-bottom: 2px solid var(--ink);
  }

  .photo {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-bottom: 2px solid var(--ink);
    background: var(--paper-dim);
    padding: 0.5rem;
    overflow: hidden;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: scale 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fleet-card:has(.card-open:hover) .photo :global(img) {
    scale: 1.03;
  }

  /* Photographs fill the frame edge to edge; cutouts keep their padding. */
  .photo-cover {
    padding: 0;
  }

  .photo-cover :global(img) {
    object-fit: cover;
    object-position: center 55%;
  }

  .count {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.6rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .spec {
    padding: 1.4rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .tier {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ox);
  }

  h3 {
    font-size: var(--text-h3);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .cap {
    font-size: var(--text-sm);
    font-weight: 500;
    border-block: 1px solid var(--line-paper);
    padding-block: 0.5rem;
    margin-block: 0.3rem;
  }

  .cap span {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray);
    margin-right: 0.5rem;
  }

  .desc {
    font-size: var(--text-sm);
    color: var(--gray);
    flex: 1;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
  }

  .view {
    color: var(--gray);
    transition: color 160ms ease-out;
  }

  .fleet-card:has(.card-open:hover) .view {
    color: var(--ink);
  }

  .inquire {
    position: relative;
    z-index: 1;
    font-weight: 400;
    color: var(--ox);
    text-decoration: none;
  }

  .inquire:hover {
    color: var(--ink);
  }

  /* ---- Viewer ---- */

  .viewer {
    /* The global margin reset would pin the dialog top-left; recentre it. */
    margin: auto;
    width: min(76rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  .viewer::backdrop {
    background: rgba(13, 13, 14, 0.82);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .frame {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.75fr);
    max-height: calc(100dvh - 2rem - 4px);
  }

  .close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 140ms ease-out, color 140ms ease-out;
  }

  .close:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .gallery {
    position: relative;
    background: var(--paper-dim);
    border-right: 2px solid var(--ink);
    min-height: 0;
    min-width: 0;
  }

  .track {
    display: flex;
    height: 100%;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline-offset: -3px;
  }

  .shot {
    --pad: clamp(1rem, 3vw, 2.5rem);
    position: relative;
    flex: 0 0 100%;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    max-height: calc(100dvh - 2rem - 4px);
    padding: var(--pad);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Absolutely positioned so the photo sizes against the slide's real box
     (the slide's own height comes from its aspect ratio, so percentage
     heights on a normal-flow image would not resolve). Portrait and
     landscape photos alike fit entirely within the frame. */
  .shot :global(img) {
    position: absolute;
    top: var(--pad);
    left: var(--pad);
    width: calc(100% - 2 * var(--pad));
    height: calc(100% - 2 * var(--pad));
    object-fit: contain;
  }

  .shot.photo-tbd {
    border: 0;
    min-height: 0;
  }

  .step {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 140ms ease-out, color 140ms ease-out, opacity 140ms ease-out;
  }

  .step:hover:not(:disabled) {
    background: var(--ink);
    color: var(--paper);
  }

  .step:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .prev {
    left: 0.9rem;
  }

  .next {
    right: 0.9rem;
  }

  .counter {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    z-index: 2;
    padding: 0.3rem 0.6rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    padding-top: 3.75rem;
    overflow-y: auto;
  }

  .detail h2 {
    font-size: var(--text-h2);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .detail .cap {
    margin-block: 0.5rem;
  }

  .detail .desc {
    flex: 0;
  }

  .note {
    font-size: var(--text-sm);
    border-left: 3px solid var(--ox);
    padding-left: 0.9rem;
    margin-top: 0.4rem;
  }

  .acts {
    display: grid;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .acts .btn {
    text-align: center;
  }

  .phone {
    font-size: var(--text-xs);
  }

  .phone a {
    color: var(--ox);
    font-weight: 500;
    text-decoration: none;
  }

  .phone a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    /* Phones and portrait tablets: the viewer takes the screen; the photo
       strip sits on top, the spec scrolls beneath, actions close the sheet. */
    .viewer {
      width: 100vw;
      height: 100dvh;
      max-height: none;
      margin: 0;
      border: 0;
    }

    .frame {
      /* minmax(0, …): the ten-slide track must never widen the frame */
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      height: 100dvh;
      max-height: none;
    }

    .gallery {
      border-right: 0;
      border-bottom: 2px solid var(--ink);
    }

    /* A fixed share of the screen: portrait photographs stand tall,
       landscape cutouts centre in the same frame. */
    .shot {
      --pad: 1rem;
      aspect-ratio: auto;
      height: 52dvh;
      max-height: none;
    }

    .close {
      top: 0.75rem;
      right: 0.75rem;
    }

    .detail {
      padding-top: 1.5rem;
    }

    .acts {
      position: sticky;
      bottom: 0;
      margin: auto calc(-1 * clamp(1.5rem, 3vw, 2.25rem)) 0;
      padding: 1rem clamp(1.5rem, 3vw, 2.25rem);
      background: var(--paper);
      border-top: 1px solid var(--line-paper);
    }
  }

  @media (max-width: 480px) {
    .step {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
