---
/*
  Closing action block — black chancery field.
  variant="consult" leads with the consultation; variant="book" leads with booking.
*/
interface Props {
  heading?: string;
  body?: string;
  variant?: "consult" | "book";
  /* Canonical service name — preselects the contact form's service pill. */
  service?: string;
}

const {
  heading = "Speak with our operations team.",
  body = "Tell us the principals, schedule, and security considerations. A coordinator responds directly, 24 hours a day.",
  variant = "consult",
  service,
} = Astro.props;

const contactHref = service ? `/contact?service=${encodeURIComponent(service)}` : "/contact";
---

<section class="cta field-ox">
  <div class="wrap inner">
    <h2>{heading}</h2>
    <div class="side">
      <p>{body}</p>
      <div class="acts">
        {
          variant === "book" ? (
            <>
              <a class="btn btn-light" href="/book" data-track="cta-book">Book Now</a>
              <a class="btn btn-ghost" href={contactHref} data-track="cta-consult">Request a Consultation</a>
            </>
          ) : (
            <>
              <a class="btn btn-light" href={contactHref} data-track="cta-consult">Request a Consultation</a>
              <a class="btn btn-ghost" href="/book" data-track="cta-book">Book Now</a>
            </>
          )
        }
      </div>
      <p class="phone">
        <a href="tel:+17032874227">+1 703-287-4227</a> ·
        <a href="https://wa.me/17032874227" rel="noopener">WhatsApp</a> · answered 24/7
      </p>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3rem;
    align-items: center;
  }

  h2 {
    font-size: clamp(2rem, 1.4rem + 2.8vw, 3.5rem);
  }

  .side p:first-child {
    color: var(--soft);
    max-width: 48ch;
    margin-bottom: 1.5rem;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .cta .btn-ghost {
    border-color: var(--line-onred);
  }

  .cta .btn-ghost:hover {
    border-color: var(--paper);
  }

  .phone {
    font-size: var(--text-sm);
    margin-top: 1.25rem;
  }

  .phone a {
    color: var(--paper);
    font-weight: 500;
    text-decoration: none;
  }

  .phone a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
