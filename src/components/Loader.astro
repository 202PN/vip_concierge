---
/*
  Site loader — the seal centered on a solid ink curtain that parts like a
  pair of garage doors once the page has loaded.

  Progressive enhancement: the curtain only appears when the inline script
  below adds `is-loading` to <html> before first paint, so visitors without
  JavaScript never see a stuck overlay.

  When it plays: on a refresh, and on a fresh entry into the site (typed URL,
  external link, bookmark). It stays out of the way when the visitor arrives
  by clicking a link within the site, or via back / forward.
*/
const MIN_SHOW_MS = 1100; // hold the seal at least this long
const MAX_WAIT_MS = 5000; // open no matter what after this
---

<script is:inline>
  (function () {
    var nav = performance.getEntriesByType("navigation")[0];
    var type = nav ? nav.type : "navigate";
    if (type === "back_forward") return;
    var internal = false;
    try {
      internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
    } catch (_) {}
    if (type !== "reload" && internal) return;
    document.documentElement.classList.add("is-loading");
  })();
</script>

<div class="loader" id="site-loader" aria-hidden="true">
  <div class="door door-top"></div>
  <div class="door door-bottom"></div>
  <div class="seam"></div>
  <div class="mark">
    <img class="seal" src="/vip_red2.png" alt="" width="630" height="630" decoding="async" fetchpriority="high" />
    <p class="tagline">Getting things done your way.</p>
  </div>
</div>

<script is:inline define:vars={{ MIN_SHOW_MS, MAX_WAIT_MS }}>
  (function () {
    var html = document.documentElement;
    var loader = document.getElementById("site-loader");
    if (!loader) return;
    if (!html.classList.contains("is-loading")) {
      loader.remove();
      return;
    }

    var start = performance.now();
    var opened = false;

    function open() {
      if (opened) return;
      opened = true;
      loader.classList.add("is-open");
      html.classList.remove("is-loading");
      html.classList.add("is-loaded");
      var done = function () {
        loader.remove();
      };
      loader.querySelector(".door-top").addEventListener("transitionend", done, { once: true });
      setTimeout(done, 2200); // safety: reduced-motion or missed event
    }

    function openWhenReady() {
      var elapsed = performance.now() - start;
      setTimeout(open, Math.max(0, MIN_SHOW_MS - elapsed));
    }

    if (document.readyState === "complete") openWhenReady();
    else window.addEventListener("load", openWhenReady, { once: true });
    setTimeout(open, MAX_WAIT_MS);
  })();
</script>

<style is:global>
  /* Page holds still under the curtain. */
  html.is-loading {
    overflow: hidden;
  }

  /* No JS, or already seen this session: the curtain never renders. */
  .loader {
    display: none;
  }

  html.is-loading .loader,
  .loader.is-open {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }

  html.is-loading .loader {
    pointer-events: auto;
  }

  .loader .door {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    background: var(--ink);
    will-change: transform;
    transition: transform 900ms cubic-bezier(0.77, 0, 0.18, 1) 480ms;
  }

  .loader .door-top {
    top: 0;
    height: calc(50% + 1px); /* overlap: no hairline on odd viewport heights */
  }

  .loader .door-bottom {
    bottom: 0;
  }

  /* The seam where the two doors meet: two oxblood hairlines running from
     the screen edges to just short of the seal, breathing while the page
     loads, then vanishing as the doors part. */
  .loader {
    --seal-w: clamp(7.5rem, 22vw, 12rem);
    --seam-gap: 1rem;
  }

  .loader .seam {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 1px;
    width: 100%;
    transform: translate(-50%, -50%);
    transition: opacity 320ms ease;
  }

  .loader .seam::before,
  .loader .seam::after {
    content: "";
    position: absolute;
    top: 0;
    height: 1px;
    width: calc(50% - var(--seal-w) / 2 - var(--seam-gap));
    background: var(--ox-bright);
    animation: seam-breathe 1.8s ease-in-out infinite alternate;
  }

  .loader .seam::before {
    left: 0;
  }

  .loader .seam::after {
    right: 0;
  }

  /* The seal sits dead center on the screen; the tagline hangs below it
     without pulling the seal off center. Both move as one unit. */
  .loader .mark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    animation: seal-in 720ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transition:
      opacity 460ms ease,
      transform 460ms cubic-bezier(0.4, 0, 1, 1);
  }

  .loader .seal {
    width: var(--seal-w);
    height: auto;
    filter: drop-shadow(0 12px 32px rgba(0, 0, 0, 0.55));
  }

  .loader .tagline {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 1.5rem;
    white-space: nowrap;
    font-family: var(--fr);
    font-weight: 300;
    font-size: clamp(0.9375rem, 0.8rem + 0.6vw, 1.1875rem);
    letter-spacing: 0.06em;
    line-height: 1.2;
    color: var(--paper);
    text-align: center;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
  }

  /* Opening: the mark recedes first, then the doors part. */
  .loader.is-open .mark {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.82);
    animation: none;
  }

  .loader.is-open .seam {
    opacity: 0;
    animation: none;
  }

  .loader.is-open .door-top {
    transform: translateY(-100%);
  }

  .loader.is-open .door-bottom {
    transform: translateY(100%);
  }

  @keyframes seal-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes seam-breathe {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader .door {
      transition: opacity 500ms ease 200ms;
    }
    .loader.is-open .door-top,
    .loader.is-open .door-bottom {
      transform: none;
      opacity: 0;
    }
    .loader .mark,
    .loader .seam::before,
    .loader .seam::after {
      animation: none;
    }
  }
</style>
